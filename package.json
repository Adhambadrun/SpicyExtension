{
  "name": "bcf-flight-assistant",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "BCFlights source audit and local-only Basis result inspector. The flight assistant is not yet implemented.",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run icons:check && npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "22.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
