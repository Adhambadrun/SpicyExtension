{
  "manifest_version": 3,
  "name": "SpicyExtension",
  "version": "1.0.0",
  "description": "Review one selected result area and export it locally as JSON. No automatic uploads, no storage, no background capture.",
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://agentsearch.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SpicyExtension — capture one result area",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://agentsearch.vercel.app/flights*",
        "https://agentsearch.vercel.app/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "help.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  }
}
